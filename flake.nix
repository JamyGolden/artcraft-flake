{
  description = "ArtCraft: open-source, native creative apps (PhotoCraft, FilmCraft, VectorCraft, etc)";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    # nixpkgs dropped Intel Macs in 26.11; 26.05 still has them (security fixes until the end of 2026).
    nixpkgs-x86_64-darwin.url = "github:NixOS/nixpkgs/nixpkgs-26.05-darwin";
    flake-parts = {
      url = "github:hercules-ci/flake-parts";
      inputs.nixpkgs-lib.follows = "nixpkgs";
    };

    # Only for the `home-manager-generation` check; Nix doesn't fetch it unless the check runs.
    home-manager = {
      url = "github:nix-community/home-manager";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };

  outputs = inputs @ {flake-parts, ...}:
    flake-parts.lib.mkFlake {inherit inputs;} (
      let
        systems = ["x86_64-linux" "aarch64-linux" "x86_64-darwin" "aarch64-darwin"];

        # Static per-app metadata (apps.nix) merged with each app's pinned release (releases.json,
        # regenerated by ./scripts/update.sh). macOS has one universal build: the app's .dmg and the CLI's .zip.
        releases = builtins.fromJSON (builtins.readFile ./releases.json);
        apps = builtins.mapAttrs (name: app:
          {
            repo = name;
            cli = true;
            mime = true;
            buildInputs = _: [];
            runtimeLibs = _: [];
            driverLibs = false;
            appId = "ai.storyteller.${name}";
            homepage = "https://github.com/storytold/${app.repo or name}";
            release = releases.${name};
          }
          // app) (import ./apps.nix);
        appNames = builtins.attrNames apps;
        cliApps = builtins.filter (name: apps.${name}.cli) appNames;

        releaseUrl = app: file: "https://github.com/storytold/${app.repo}/releases/download/v${app.release.version}/${file}";

        # winit and wgpu dlopen these at runtime (and most apps dbus), so they go on every app's RPATH.
        runtimeLibsFor = pkgs:
          with pkgs; [
            wayland
            libxkbcommon
            vulkan-loader
            libGL
            libx11
            libxcursor
            libxrandr
            libxi
            dbus
          ];

        # The packages, as a function of pkgs: `packages` uses the flake's pinned nixpkgs, and
        # the overlay uses whatever nixpkgs it's applied to. The attribute names must not depend
        # on pkgs, or the overlay would recurse forever.
        mkPackages = pkgs: let
          inherit (pkgs) lib;
          inherit (pkgs.stdenv.hostPlatform) system isDarwin;

          # Everything an app dlopens, in the order the loader should search it.
          appRuntimeLibs = app: runtimeLibsFor pkgs ++ app.runtimeLibs pkgs;

          binaryMeta = name: app: {
            inherit (app) description homepage;
            mainProgram = name;
            platforms = systems;
            sourceProvenance = [lib.sourceTypes.binaryNativeCode];
          };

          # The prebuilt Linux binaries from the GitHub release, patched to run on Nix.
          linuxBinary = name: app:
            pkgs.stdenv.mkDerivation {
              pname = name;
              inherit (app.release) version;

              src = pkgs.fetchurl {
                url = releaseUrl app "${name}-${app.release.version}-linux-${pkgs.stdenv.hostPlatform.parsed.cpu.name}.tar.gz";
                hash = app.release.hashes.${system};
              };

              nativeBuildInputs = [pkgs.autoPatchelfHook];
              buildInputs = [pkgs.stdenv.cc.cc.lib] ++ app.buildInputs pkgs;
              # The `lib` outputs: autoPatchelf adds `<dep>/lib`, which is empty in dbus's default output.
              runtimeDependencies = map lib.getLib (appRuntimeLibs app);
              appendRunpaths = lib.optional app.driverLibs "${pkgs.addDriverRunpath.driverLink}/lib";

              installPhase = ''
                runHook preInstall
                mkdir -p $out
                cp -R bin share $out/
                runHook postInstall
              '';

              meta = binaryMeta name app;
            };

          # The universal macOS release: <App>.app from the .dmg, and <app>-cli from its .zip.
          darwinBinary = name: app: let
            inherit (app.release) version;
            bundle = "$out/Applications/${app.displayName}.app";
          in
            pkgs.stdenvNoCC.mkDerivation {
              pname = name;
              inherit version;

              srcs =
                [
                  (pkgs.fetchurl {
                    url = releaseUrl app "${name}-${version}-macos-universal.dmg";
                    hash = app.release.hashes.macos-dmg;
                  })
                ]
                ++ lib.optional app.cli (pkgs.fetchurl {
                  url = releaseUrl app "${name}-cli-${version}-macos-universal.zip";
                  hash = app.release.hashes.macos-cli-zip;
                });
              sourceRoot = ".";

              # The .dmg is HFS+, which 7-Zip can unpack without mounting it.
              nativeBuildInputs = with pkgs; [_7zz unzip];
              unpackCmd = ''
                case "$curSrc" in
                  *.dmg) 7zz x -snld "$curSrc" ;;
                  *) unzip -q "$curSrc" ;;
                esac
              '';

              # The .dmg's top-level folder is its volume name, which has changed between releases.
              installPhase =
                ''
                  runHook preInstall
                  app=$(find . -maxdepth 2 -type d -name ${lib.escapeShellArg "${app.displayName}.app"} | head -n1)
                  if [ -z "$app" ]; then echo "${app.displayName}.app not found in the .dmg"; exit 1; fi
                  mkdir -p $out/Applications $out/bin
                  cp -R "$app" $out/Applications/
                  test -x "${bundle}/Contents/MacOS/${app.displayName}"
                  cat > $out/bin/${name} <<EOF
                  #!${pkgs.runtimeShell}
                  exec "${bundle}/Contents/MacOS/${app.displayName}" "\$@"
                  EOF
                  chmod +x $out/bin/${name}
                ''
                + lib.optionalString app.cli ''
                  install -Dm755 ${name}-cli-${version}-macos-universal/${name}-cli $out/bin/${name}-cli
                ''
                + ''
                  runHook postInstall
                '';

              # Stripping or patching would invalidate upstream's code signatures.
              dontFixup = true;

              meta = binaryMeta name app;
            };

          # Not lib.genAttrs: in the overlay, lib comes from `final`, so its names would depend on pkgs.
          binaries = builtins.listToAttrs (map (name: {
              inherit name;
              value =
                (
                  if isDarwin
                  then darwinBinary
                  else linuxBinary
                )
                name
                apps.${name};
            })
            appNames);
        in
          binaries
          // {
            # Every app in one package. buildEnv symlinks each <App>.app whole, so nix-darwin and
            # Home Manager see the bundles as they would with the apps installed one by one.
            artcraft = pkgs.buildEnv {
              name = "artcraft";
              paths = builtins.attrValues binaries;
              pathsToLink = ["/bin" "/share" "/Applications"];
              meta = {
                description = "Every ArtCraft app: ${lib.concatStringsSep ", " (map (name: apps.${name}.displayName) appNames)}";
                homepage = "https://getartcraft.com/apps";
                platforms = systems;
              };
            };
          };

        # `programs.artcraft.<app>.enable = true;` installs an app. The packages are built with the
        # user's pkgs, like the overlay's.
        homeModule = {
          config,
          lib,
          pkgs,
          ...
        }: let
          cfg = config.programs.artcraft;
          packages = mkPackages pkgs;
        in {
          options.programs.artcraft = lib.genAttrs appNames (name: let
            inherit (apps.${name}) displayName;
          in {
            enable = lib.mkEnableOption "${displayName}, ${lib.toLower (builtins.substring 0 1 apps.${name}.description)}${builtins.substring 1 (-1) apps.${name}.description}";
            package = lib.mkOption {
              type = lib.types.package;
              default = packages.${name};
              defaultText = lib.literalMD "the ${displayName} release binaries";
              description = "The ${displayName} package to install.";
            };
          });

          config.home.packages = map (name: cfg.${name}.package) (builtins.filter (name: cfg.${name}.enable) appNames);
        };
      in {
        inherit systems;

        # Home Manager module; `homeModules` is the current name, `homeManagerModules` the older one.
        flake.homeModules.default = homeModule;
        flake.homeManagerModules.default = homeModule;

        # Adds every app and the `artcraft` bundle to pkgs, built with that nixpkgs.
        flake.overlays.default = final: prev: mkPackages final;

        perSystem = {
          system,
          pkgs,
          lib,
          self',
          ...
        }: let
          inherit (pkgs.stdenv.hostPlatform) isLinux;
          runtimeLibs = runtimeLibsFor pkgs;
          appRuntimeLibs = name: runtimeLibs ++ apps.${name}.runtimeLibs pkgs;
          pkg = name: self'.packages.${name};
          pc = pkg "photocraft";
          # A 64x64 test image that exists on every platform (the macOS package has no hicolor icons).
          icon = "${pkgs.nixos-icons}/share/icons/hicolor/64x64/apps/nix-snowflake.png";
        in {
          _module.args.pkgs =
            inputs.${
              if system == "x86_64-darwin"
              then "nixpkgs-x86_64-darwin"
              else "nixpkgs"
            }.legacyPackages.${
              system
            };

          # `nix fmt` formats the flake's Nix files. Given no paths (`nix fmt`, `nix fmt -- --check`),
          # alejandra would read stdin, so default to the flake root (PRJ_ROOT, set by `nix fmt`).
          formatter = pkgs.writeShellApplication {
            name = "alejandra";
            runtimeInputs = [pkgs.alejandra];
            text = ''
              for arg in "$@"; do
                case "$arg" in
                  -*) ;;
                  *) exec alejandra "$@" ;;
                esac
              done
              exec alejandra "$@" "''${PRJ_ROOT:-.}"
            '';
          };

          packages = let
            all = mkPackages pkgs;
          in
            all // {default = all.artcraft;};

          apps =
            lib.genAttrs appNames (name: {
              program = lib.getExe (pkg name);
              meta.description = "${apps.${name}.displayName}: ${apps.${name}.description}";
            })
            // lib.listToAttrs (map (name:
              lib.nameValuePair "${name}-cli" {
                program = "${pkg name}/bin/${name}-cli";
                meta.description = "Headless ${apps.${name}.displayName}";
              })
            cliApps)
            // {default = self'.apps.photocraft;};

          # `nix develop` has every app's release binaries on PATH, the Rust toolchain and the native
          # libraries every app builds against, for `cargo run` from a checkout of any of them.
          # `nix develop .#<app>` has just that app's release binaries and libraries.
          devShells = let
            mkShell = names: packages:
              pkgs.mkShell ({
                  packages =
                    packages
                    ++ (with pkgs; [
                      cargo
                      rustc
                      clippy
                      rustfmt
                      rust-analyzer
                      alejandra
                      jq # for scripts/update.sh
                    ]);
                  RUST_SRC_PATH = "${pkgs.rustPlatform.rustLibSrc}";
                }
                // lib.optionalAttrs isLinux {
                  nativeBuildInputs = [pkgs.pkg-config];
                  buildInputs = lib.unique (lib.concatMap (name: appRuntimeLibs name ++ apps.${name}.buildInputs pkgs) names);
                  # No RPATH patching for `cargo run`, so point the dynamic loader at the dlopen'd libs.
                  LD_LIBRARY_PATH = lib.makeLibraryPath (lib.unique (lib.concatMap appRuntimeLibs names));
                });
          in
            lib.genAttrs appNames (name: mkShell [name] [(pkg name)])
            // {default = mkShell appNames [(pkg "artcraft")];};

          # `nix flake check` fetches every app's release, builds the dev shell, then smoke-tests the
          # result.
          checks =
            {
              devShell = self'.devShells.default;
              artcraft = pkg "artcraft";

              # The Home Manager module installs exactly the enabled apps, and honours `package`.
              home-manager-module = let
                hm = lib.evalModules {
                  modules = [
                    homeModule
                    {
                      # Stands in for Home Manager's own option.
                      options.home.packages = lib.mkOption {type = lib.types.listOf lib.types.package;};
                      config = {
                        _module.args.pkgs = pkgs;
                        programs.artcraft.photocraft.enable = true;
                        programs.artcraft.gridcraft = {
                          enable = true;
                          package = pkg "artcraft";
                        };
                        programs.artcraft.filmcraft.enable = false;
                      };
                    }
                  ];
                };
                names = map (p: p.name) hm.config.home.packages;
                expected = ["artcraft" (pkg "photocraft").name];
              in
                assert lib.assertMsg (lib.sort lib.lessThan names == lib.sort lib.lessThan expected)
                "home.packages is ${toString names}, expected ${toString expected}";
                  pkgs.emptyFile;

              # The overlay adds the apps to the nixpkgs it's applied to. `nix flake check` only
              # checks an overlay's shape, so this is what catches it failing to evaluate.
              overlay = let
                overlaid = pkgs.extend inputs.self.overlays.default;
              in
                assert lib.assertMsg (overlaid.photocraft.name == pc.name && overlaid.artcraft.name == (pkg "artcraft").name)
                "the overlay's packages differ from the flake's";
                  pkgs.emptyFile;

              # The headless engine converts images, including decoding HEIC (the `heif` feature), and
              # the release has a commit and build date compiled in.
              photocraft-cli = pkgs.runCommand "photocraft-check-cli" {nativeBuildInputs = [pc pkgs.libheif];} ''
                photocraft-cli --version | grep -Eq '^photocraft-cli [^ ]+ \([0-9a-f]{9}, [0-9]{4}-[0-9]{2}-[0-9]{2}\)$'

                photocraft-cli convert ${icon} out.jpg --quality 80
                photocraft-cli info out.jpg --compact | grep -q '"width":64'

                heif-enc -o in.heic ${icon}
                photocraft-cli convert in.heic back.png
                photocraft-cli info back.png --compact | grep -q '"height":64'
                touch $out
              '';
            }
            # The module works in a real Home Manager configuration: the generation builds (including
            # the manual, which renders the module's option docs) and has exactly the enabled apps.
            # Not on Intel Macs, whose nixpkgs is older than Home Manager's main branch expects.
            // lib.optionalAttrs (system != "x86_64-darwin") {
              home-manager-generation = let
                hm = inputs.home-manager.lib.homeManagerConfiguration {
                  inherit pkgs;
                  modules = [
                    homeModule
                    {
                      home = {
                        username = "artcraft";
                        homeDirectory =
                          if pkgs.stdenv.hostPlatform.isDarwin
                          then "/Users/artcraft"
                          else "/home/artcraft";
                        stateVersion = "25.11";
                      };
                      programs.artcraft.photocraft.enable = true;
                      programs.artcraft.artcraft-launcher.enable = true;
                    }
                  ];
                };
              in
                pkgs.runCommand "home-manager-generation-check" {} ''
                  test -e ${hm.activationPackage}/activate
                  bin=${hm.config.home.path}/bin
                  for app in photocraft photocraft-cli artcraft-launcher; do
                    test -x $bin/$app || { echo "$app missing from the generation"; exit 1; }
                  done
                  if [ -e $bin/filmcraft ]; then echo "filmcraft installed but not enabled"; exit 1; fi
                  touch $out
                '';
            }
            # Each CLI runs, and is the release it claims to be.
            // lib.listToAttrs (map (name: let
              inherit (apps.${name}.release) version;
            in
              lib.nameValuePair "${name}-version" (pkgs.runCommand "${name}-check-version" {} ''
                actual=$(${pkg name}/bin/${name}-cli --version | head -n1)
                if ! echo "$actual" | grep -Eq ' ${lib.escapeRegex version}( |$)'; then
                  echo "unexpected version: $actual"
                  exit 1
                fi
                touch $out
              ''))
            cliApps)
            # Desktop integration is valid, and the libraries the app dlopens are on the RPATH.
            // lib.optionalAttrs isLinux (lib.genAttrs' appNames (name: let
              inherit (apps.${name}) appId cli mime driverLibs;
              p = pkg name;
              bins = ["${p}/bin/${name}"] ++ lib.optional cli "${p}/bin/${name}-cli";
              rpathDirs =
                map (l: "${lib.getLib l}/lib") (appRuntimeLibs name)
                ++ lib.optional driverLibs "${pkgs.addDriverRunpath.driverLink}/lib";
            in
              lib.nameValuePair "${name}-install" (pkgs.runCommand "${name}-check-install"
                {nativeBuildInputs = [pkgs.desktop-file-utils pkgs.patchelf];} ''
                  desktop-file-validate ${p}/share/applications/${appId}.desktop
                  ${lib.optionalString mime "test -f ${p}/share/mime/packages/${appId}.xml"}
                  # Not every app has a scalable icon (CADCraft is PNG only).
                  ls ${p}/share/icons/hicolor/*/apps/${appId}.* >/dev/null
                  for bin in ${lib.concatStringsSep " " bins}; do
                    rpath=$(patchelf --print-rpath "$bin")
                    for lib in ${lib.concatStringsSep " " rpathDirs}; do
                      case ":$rpath:" in
                        *":$lib:"*) ;;
                        *) echo "$bin: $lib missing from RPATH"; exit 1 ;;
                      esac
                    done
                  done
                  touch $out
                '')));
        };
      }
    );
}
